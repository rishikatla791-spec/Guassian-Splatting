<?xml version="1.0" encoding="utf-8"?>
<!--
    Live capture. The camera image is full-bleed; all chrome is frosted glass
    so nothing competes with the subject.

    IDs consumed by CaptureActivity - do not rename or change view types:
      gl_surface_capture (GLSurfaceView), btn_record_scan (Button),
      tv_capture_status (TextView), tv_frame_count (TextView),
      progress_upload (ProgressBar).
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/canvas_black">

    <android.opengl.GLSurfaceView
        android:id="@+id/gl_surface_capture"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Legibility scrims. Pure gradients, no blur cost. -->
    <View
        android:layout_width="0dp"
        android:layout_height="@dimen/capture_scrim_top"
        android:background="@drawable/glass_scrim_top"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:layout_width="0dp"
        android:layout_height="@dimen/capture_scrim_bottom"
        android:background="@drawable/glass_scrim_bottom"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- ============ Framing guide ============ -->
    <View
        android:id="@+id/view_reticle"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layerType="software"
        android:layout_marginStart="@dimen/space_5xl"
        android:layout_marginEnd="@dimen/space_5xl"
        android:background="@drawable/capture_reticle"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintVertical_bias="0.42"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tv_reticle_hint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_md"
        android:background="@drawable/glass_chip"
        android:paddingStart="@dimen/space_lg"
        android:paddingTop="@dimen/space_sm"
        android:paddingEnd="@dimen/space_lg"
        android:paddingBottom="@dimen/space_sm"
        android:text="@string/capture_reticle_hint"
        android:textAppearance="@style/TextAppearance.Glass.Caption"
        app:layout_constraintEnd_toEndOf="@id/view_reticle"
        app:layout_constraintStart_toStartOf="@id/view_reticle"
        app:layout_constraintTop_toBottomOf="@id/view_reticle" />

    <!-- ============ Top HUD ============ -->
    <LinearLayout
        android:id="@+id/panel_capture_hud"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_lg"
        android:layout_marginTop="@dimen/space_5xl"
        android:layout_marginEnd="@dimen/space_lg"
        android:background="@drawable/glass_panel"
        android:orientation="vertical"
        android:padding="@dimen/space_xl"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <View
                android:id="@+id/dot_capture_live"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:background="@drawable/dot_mint" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_sm"
                android:layout_weight="1"
                android:text="@string/capture_overline"
                android:textAppearance="@style/TextAppearance.Glass.Overline" />

            <TextView
                android:id="@+id/tv_frame_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/glass_chip"
                android:paddingStart="@dimen/space_md"
                android:paddingTop="@dimen/space_xs"
                android:paddingEnd="@dimen/space_md"
                android:paddingBottom="@dimen/space_xs"
                android:text="@string/capture_frame_count_default"
                android:textAppearance="@style/TextAppearance.Glass.Counter"
                tools:text="128 Frames" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_capture_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md"
            android:text="@string/capture_status_default"
            android:textAppearance="@style/TextAppearance.Glass.Body" />
    </LinearLayout>

    <!-- ============ Bottom controls ============ -->
    <LinearLayout
        android:id="@+id/panel_capture_controls"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_lg"
        android:layout_marginEnd="@dimen/space_lg"
        android:layout_marginBottom="@dimen/screen_bottom_inset"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <LinearLayout
            android:id="@+id/panel_capture_tip"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/glass_panel"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="@dimen/space_lg">

            <ImageView
                android:layout_width="@dimen/icon_md"
                android:layout_height="@dimen/icon_md"
                android:contentDescription="@null"
                android:src="@drawable/ic_lightbulb"
                app:tint="@color/glass_accent" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_md"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/capture_tip_title"
                    android:textAppearance="@style/TextAppearance.Glass.Body"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_2xs"
                    android:text="@string/capture_tip_body"
                    android:textAppearance="@style/TextAppearance.Glass.Caption" />
            </LinearLayout>
        </LinearLayout>

        <ProgressBar
            android:id="@+id/progress_upload"
            style="@style/Widget.Glass.Progress"
            android:layout_width="match_parent"
            android:layout_marginTop="@dimen/space_lg"
            android:visibility="gone"
            tools:progress="42"
            tools:visibility="visible" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_record_scan"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height"
            android:layout_marginTop="@dimen/space_xl"
            android:background="@drawable/record_button_bg"
            android:contentDescription="@string/cd_record"
            android:drawableStart="@drawable/ic_record_dot"
            android:drawablePadding="@dimen/space_md"
            android:gravity="center"
            android:paddingStart="@dimen/space_2xl"
            android:paddingEnd="@dimen/space_2xl"
            android:stateListAnimator="@null"
            android:text="@string/capture_record_start"
            android:textAllCaps="false"
            android:textColor="@color/glass_text"
            android:textSize="@dimen/text_body_lg"
            android:textStyle="bold"
            app:drawableTint="@color/glass_text" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
