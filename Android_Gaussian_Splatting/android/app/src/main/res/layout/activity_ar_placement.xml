<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <android.opengl.GLSurfaceView
        android:id="@+id/surfaceview_ar"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Top Overlay Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:background="#990B0E14"
        android:layout_alignParentTop="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageButton
                android:id="@+id/btn_close_ar"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@android:drawable/ic_menu_close_clear_cancel"
                android:background="?attr/selectableItemBackgroundBorderless"
                app:tint="@android:color/white" />

            <TextView
                android:id="@+id/tv_ar_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:text="AR World Placement"
                android:textColor="@android:color/white"
                android:textSize="18sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_ar_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Point camera at a flat surface (floor or table)..."
            android:textColor="#00E5FF"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- Bottom Controls -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:padding="16dp"
        android:layout_alignParentBottom="true">

        <Button
            android:id="@+id/btn_scale_toggle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Scale: 1:1 Metric"
            android:textColor="@android:color/white"
            android:background="@drawable/bg_btn_secondary"
            android:layout_marginEnd="8dp" />

        <Button
            android:id="@+id/btn_reset_anchor"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Reset Anchor"
            android:textColor="@android:color/white"
            android:background="@drawable/bg_btn_primary" />
    </LinearLayout>

</RelativeLayout>
