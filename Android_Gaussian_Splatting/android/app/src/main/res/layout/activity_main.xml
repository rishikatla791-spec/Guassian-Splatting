<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_primary"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Top Header Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="20dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="MOBILE 3DGS PRO"
                    android:textColor="@color/accent_cyan"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.15" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Spatial Studio"
                    android:textColor="@color/text_white"
                    android:textSize="26sp"
                    android:textStyle="bold"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <!-- Status Pill -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_pill"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:gravity="center_vertical">

                <View
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:background="@drawable/bg_record_btn"
                    android:backgroundTint="@color/accent_green" />

                <TextView
                    android:id="@+id/tv_server_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="Vulkan Engine Active"
                    android:textColor="@color/accent_green"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- Card 1: Real-Time 3D Scanner (Primary) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="20dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="REAL-TIME SCANNER"
                android:textColor="@color/accent_cyan"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.1" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Capture &amp; Train Real Scene"
                android:textColor="@color/text_white"
                android:textSize="19sp"
                android:textStyle="bold"
                android:layout_marginTop="4dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Capture real-time photos around any object and train 3D Gaussians instantly on your Snapdragon 8 Gen 2 GPU."
                android:textColor="@color/text_muted"
                android:textSize="13sp"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="16dp" />

            <Button
                android:id="@+id/btn_new_scan"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/bg_btn_primary"
                android:text="📷 Start Real-Time 3D Scan"
                android:textAllCaps="false"
                android:textColor="@color/bg_primary"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Card 2: Import Custom Dataset / Splat -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="20dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="LOCAL DATASETS"
                android:textColor="@color/accent_purple"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.1" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Import 3D Gaussian Model"
                android:textColor="@color/text_white"
                android:textSize="19sp"
                android:textStyle="bold"
                android:layout_marginTop="4dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Load an existing .splat file directly from your phone storage."
                android:textColor="@color/text_muted"
                android:textSize="13sp"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="16dp" />

            <Button
                android:id="@+id/btn_import_custom_dataset"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:background="@drawable/bg_btn_secondary"
                android:text="📁 Import .splat File"
                android:textAllCaps="false"
                android:textColor="@color/text_white"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Card 4: GPU Server Link -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="20dp"
            android:layout_marginBottom="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="HYBRID ACCELERATION"
                android:textColor="@color/accent_purple"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.1" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PC RTX GPU Sync (Optional)"
                android:textColor="@color/text_white"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginTop="4dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sync over local Wi-Fi to offload intensive training to NVIDIA GPU."
                android:textColor="@color/text_muted"
                android:textSize="12sp"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="14dp" />

            <Button
                android:id="@+id/btn_server_settings"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:background="@drawable/bg_btn_secondary"
                android:text="Configure Server IP"
                android:textAllCaps="false"
                android:textColor="@color/accent_cyan"
                android:textSize="13sp"
                android:textStyle="bold" />

            <ProgressBar
                android:id="@+id/pb_loading_models"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_gravity="center"
                android:layout_marginTop="12dp"
                android:visibility="gone" />

            <ListView
                android:id="@+id/lv_models"
                android:layout_width="match_parent"
                android:layout_height="100dp"
                android:divider="@color/card_border"
                android:dividerHeight="1dp"
                android:layout_marginTop="8dp" />
        </LinearLayout>

        <!-- Footer Info -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="Powered by ArthurBrussee/brush (Vulkan) &amp; WebGL2"
            android:textColor="@color/text_dim"
            android:textSize="11sp"
            android:layout_marginBottom="16dp" />

    </LinearLayout>
</ScrollView>
