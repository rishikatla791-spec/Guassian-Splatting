<?xml version="1.0" encoding="utf-8"?>
<!--
    Home: capture hero, quick actions, live training status and the model
    gallery. The window background supplies the clay wash, so this tree stays
    transparent and every surface is a MaterialCardView with a claymorphic
    face (top-left highlight, soft tinted bottom-right shadow).
-->
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root_home"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll_home"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:clipToPadding="false"
            android:clipChildren="false"
            android:paddingStart="@dimen/screen_gutter"
            android:paddingEnd="@dimen/screen_gutter"
            android:paddingBottom="@dimen/screen_bottom_inset">

            <!-- ============ Header ============ -->
            <LinearLayout
                android:id="@+id/header_home"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingTop="@dimen/space_5xl"
                android:paddingBottom="@dimen/space_xl">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/home_overline"
                        android:textAppearance="@style/TextAppearance.Clay.Overline"
                        android:textColor="@color/clay_primary" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_xs"
                        android:text="@string/home_title"
                        android:textAppearance="@style/TextAppearance.Clay.Display" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/btn_quality_settings"
                    style="@style/Widget.Clay.IconButton"
                    android:contentDescription="@string/cd_settings"
                    android:src="@drawable/ic_tune"
                    app:tint="@color/clay_text_secondary" />
            </LinearLayout>

            <!-- ============ Device capability pill ============ -->
            <LinearLayout
                android:id="@+id/pill_device"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/clay_pill_mint"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="@dimen/space_md"
                android:paddingTop="@dimen/space_sm"
                android:paddingEnd="@dimen/space_lg"
                android:paddingBottom="@dimen/space_sm">

                <View
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:background="@drawable/dot_mint" />

                <TextView
                    android:id="@+id/tv_device_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_sm"
                    android:textAppearance="@style/TextAppearance.Clay.Caption"
                    android:textColor="@color/clay_mint_dark"
                    android:textStyle="bold"
                    tools:text="Flagship · 12.0 GB RAM" />
            </LinearLayout>

            <!-- ============ Live on-device training ============ -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_training"
                style="@style/Widget.Clay.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xl"
                android:visibility="gone"
                tools:visibility="visible">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/clay_surface_inner"
                    android:orientation="vertical"
                    android:padding="@dimen/space_xl">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:id="@+id/iv_training_bolt"
                            android:layout_width="@dimen/icon_md"
                            android:layout_height="@dimen/icon_md"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_bolt"
                            app:tint="@color/clay_primary" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/space_md"
                            android:layout_weight="1"
                            android:text="@string/training_title"
                            android:textAppearance="@style/TextAppearance.Clay.BodyStrong" />

                        <TextView
                            android:id="@+id/tv_training_pct"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/clay_pill_primary"
                            android:paddingStart="@dimen/space_md"
                            android:paddingTop="@dimen/space_xs"
                            android:paddingEnd="@dimen/space_md"
                            android:paddingBottom="@dimen/space_xs"
                            android:textAppearance="@style/TextAppearance.Clay.Caption"
                            android:textColor="@color/clay_primary_dark"
                            android:textStyle="bold"
                            tools:text="42%" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tv_training_state"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_sm"
                        android:text="@string/training_preparing"
                        android:textAppearance="@style/TextAppearance.Clay.Body" />

                    <ProgressBar
                        android:id="@+id/progress_training"
                        style="@style/Widget.Clay.Progress"
                        android:layout_width="match_parent"
                        android:layout_marginTop="@dimen/space_md" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_md"
                        android:text="@string/training_hint"
                        android:textAppearance="@style/TextAppearance.Clay.Caption" />

                    <Button
                        android:id="@+id/btn_cancel_training"
                        style="@style/Widget.Clay.Button.Ghost"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_md"
                        android:text="@string/training_cancel" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ============ Hero: capture ============ -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_capture_hero"
                style="@style/Widget.Clay.Card.Hero"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xl"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="@string/cd_capture">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/clay_hero_pressable"
                    android:minHeight="@dimen/hero_card_min_height">

                    <ImageView
                        android:id="@+id/iv_hero_glyph"
                        android:layout_width="@dimen/hero_glyph_size"
                        android:layout_height="@dimen/hero_glyph_size"
                        android:layout_gravity="end|center_vertical"
                        android:layout_marginEnd="@dimen/space_lg"
                        android:alpha="0.22"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_capture"
                        app:tint="@color/clay_on_primary" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/space_2xl">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:alpha="0.75"
                            android:text="@string/hero_eyebrow"
                            android:textAppearance="@style/TextAppearance.Clay.Overline"
                            android:textColor="@color/clay_on_primary" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_sm"
                            android:text="@string/hero_title"
                            android:textAppearance="@style/TextAppearance.Clay.Headline"
                            android:textColor="@color/clay_on_primary" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_sm"
                            android:layout_marginEnd="@dimen/space_4xl"
                            android:alpha="0.88"
                            android:text="@string/hero_subtitle"
                            android:textAppearance="@style/TextAppearance.Clay.Body"
                            android:textColor="@color/clay_on_primary" />

                        <LinearLayout
                            android:id="@+id/pill_hero_cta"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_xl"
                            android:background="@drawable/pill_on_hero"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingStart="@dimen/space_xl"
                            android:paddingTop="@dimen/space_md"
                            android:paddingEnd="@dimen/space_lg"
                            android:paddingBottom="@dimen/space_md">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/hero_cta"
                                android:textAppearance="@style/TextAppearance.Clay.Label"
                                android:textColor="@color/clay_primary_dark" />

                            <ImageView
                                android:layout_width="@dimen/icon_sm"
                                android:layout_height="@dimen/icon_sm"
                                android:layout_marginStart="@dimen/space_sm"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_arrow_right"
                                app:tint="@color/clay_primary_dark" />
                        </LinearLayout>
                    </LinearLayout>
                </FrameLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ============ Quick actions ============ -->
            <LinearLayout
                android:id="@+id/row_quick_actions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_lg"
                android:orientation="horizontal">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_import"
                    style="@style/Widget.Clay.Card.Tile"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/clay_surface_inner_md"
                        android:orientation="vertical"
                        android:padding="@dimen/space_lg">

                        <FrameLayout
                            android:layout_width="@dimen/icon_xl"
                            android:layout_height="@dimen/icon_xl"
                            android:background="@drawable/clay_icon_bubble">

                            <ImageView
                                android:layout_width="@dimen/icon_md"
                                android:layout_height="@dimen/icon_md"
                                android:layout_gravity="center"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_import"
                                app:tint="@color/clay_primary" />
                        </FrameLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_md"
                            android:text="@string/action_import_title"
                            android:textAppearance="@style/TextAppearance.Clay.BodyStrong" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_2xs"
                            android:text="@string/action_import_subtitle"
                            android:textAppearance="@style/TextAppearance.Clay.Caption" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <Space
                    android:layout_width="@dimen/space_md"
                    android:layout_height="1dp" />

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_quality"
                    style="@style/Widget.Clay.Card.Tile"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/clay_surface_inner_md"
                        android:orientation="vertical"
                        android:padding="@dimen/space_lg">

                        <FrameLayout
                            android:layout_width="@dimen/icon_xl"
                            android:layout_height="@dimen/icon_xl"
                            android:background="@drawable/clay_icon_bubble_mint">

                            <ImageView
                                android:layout_width="@dimen/icon_md"
                                android:layout_height="@dimen/icon_md"
                                android:layout_gravity="center"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_tune"
                                app:tint="@color/clay_mint_dark" />
                        </FrameLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_md"
                            android:text="@string/action_quality_title"
                            android:textAppearance="@style/TextAppearance.Clay.BodyStrong" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_2xs"
                            android:text="@string/action_quality_subtitle"
                            android:textAppearance="@style/TextAppearance.Clay.Caption" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- ============ Gallery section header ============ -->
            <LinearLayout
                android:id="@+id/row_gallery_header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_3xl"
                android:layout_marginBottom="@dimen/space_lg"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/gallery_title"
                    android:textAppearance="@style/TextAppearance.Clay.TitleLarge" />

                <TextView
                    android:id="@+id/tv_model_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/clay_pill_soft"
                    android:paddingStart="@dimen/space_md"
                    android:paddingTop="@dimen/space_xs"
                    android:paddingEnd="@dimen/space_md"
                    android:paddingBottom="@dimen/space_xs"
                    android:textAppearance="@style/TextAppearance.Clay.Caption"
                    android:textColor="@color/clay_text_secondary"
                    android:textStyle="bold"
                    tools:text="3 models" />
            </LinearLayout>

            <ProgressBar
                android:id="@+id/pb_loading_models"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="@dimen/space_lg"
                android:indeterminateTint="@color/clay_primary"
                android:visibility="gone" />

            <!-- ============ Empty state ============ -->
            <LinearLayout
                android:id="@+id/layout_empty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingTop="@dimen/space_lg"
                android:paddingBottom="@dimen/space_3xl"
                android:visibility="gone"
                tools:visibility="visible">

                <ImageView
                    android:layout_width="@dimen/empty_glyph_size"
                    android:layout_height="@dimen/empty_glyph_size"
                    android:contentDescription="@string/cd_empty_illustration"
                    android:src="@drawable/ic_empty_gallery" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_lg"
                    android:text="@string/empty_title"
                    android:textAppearance="@style/TextAppearance.Clay.Title" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_sm"
                    android:layout_marginStart="@dimen/space_lg"
                    android:layout_marginEnd="@dimen/space_lg"
                    android:gravity="center"
                    android:text="@string/empty_body"
                    android:textAppearance="@style/TextAppearance.Clay.Body" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btn_empty_capture"
                    style="@style/Widget.Clay.Button"
                    android:layout_width="wrap_content"
                    android:layout_marginTop="@dimen/space_xl"
                    android:text="@string/empty_cta" />
            </LinearLayout>

            <!-- ============ Model gallery ============ -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_models"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipToPadding="false"
                android:nestedScrollingEnabled="false"
                android:overScrollMode="never"
                tools:itemCount="3"
                tools:listitem="@layout/item_model" />

            <TextView
                android:id="@+id/tv_footer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_2xl"
                android:gravity="center"
                android:text="@string/footer_engine"
                android:textAppearance="@style/TextAppearance.Clay.Caption" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
