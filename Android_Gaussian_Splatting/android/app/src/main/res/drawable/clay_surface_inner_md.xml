<?xml version="1.0" encoding="utf-8"?>
<!-- Same clay face as clay_surface_inner, at the medium corner radius. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android">
    <gradient
        android:angle="315"
        android:startColor="@color/clay_highlight_inner"
        android:centerColor="@color/clay_surface_elevated"
        android:endColor="@color/clay_surface"
        android:type="linear" />
    <stroke
        android:width="@dimen/stroke_hairline"
        android:color="@color/clay_shadow_light_60" />
    <corners android:radius="@dimen/radius_md" />
</shape>
