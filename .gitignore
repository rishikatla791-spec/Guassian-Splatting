# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.pyd
*.obj
*.lib
*.exp
*.pdb
*.ilk
*.idb

# C extensions & build directories
build/
dist/
*.egg-info/
.eggs/

# Datasets and large asset directories
Room/
Room_dataset/
truck/
data/
downloads/
output/
real output/
output_*/
viewers/
msvc/
imgaes*/
output images/

# Large binaries, models, checkpoints & archives
*.zip
*.tar.gz
*.7z
*.ply
*.splat
*.obj
*.glb
*.gltf
*.pth
*.pt
*.ckpt

# Video & large render outputs
*.mp4
*.avi
*.mov
*.mkv
*.gif

# Root level images (keep repo lightweight)
/*.png
/*.jpg
/*.jpeg
/*.exr

# Exceptions for documentation assets
!assets/*.png
!assets/*.jpg
!docs/*.png
!docs/*.jpg

# Testing & Cache
.pytest_cache/
.coverage
htmlcov/
*.coverage.*

# OS / Editor files
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp

# Environment
.env
.venv/
env/
venv/
ENV/
*.log

# Scratch & temporary scripts
scratch_*
.claude/
mcp-builder/
webapp-testing/
frontend-design/
